# `git-checks` é config do PNPM: ele recusa publicar de branch que não seja a
# publicável ou com working tree suja. O publish roda a partir de uma tag (HEAD
# detached), então precisa ser desligado.
#
# Vive AQUI, e não como `--no-git-checks` na linha de comando, porque o `pnpm
# publish` delega ao npm quando há `--provenance`, e o npm 12 rejeita flag que
# não conhece:
#
#     npm error code EUNKNOWNCONFIG
#     npm error Unknown cli flag:
#     npm error   - --git-checks
#
# Em arquivo, o npm apenas AVISA sobre config desconhecida e segue — foi assim
# que o `always-auth` conviveu ali por versões a fio.
git-checks=false
